# HOJ 项目 .gitignore

# 数据目录（运行时生成，不提交）
data/

# 环境变量（含密码，不提交）
.env

# 日志
*.log

# IDE
.idea/
.vscode/
*.iml
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Node
hoj-vue/node_modules/
hoj-vue/dist/

# Java
*.class
*.jar
target/
*.war

# Maven
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# 临时文件
*.tmp
*.bak
