# ============================================================
# HOJ 环境变量配置模板
# ============================================================
# 复制此文件为 .env 并修改密码
# cp .env.example .env
# ============================================================

# ---------- 数据库（必须修改）----------
MYSQL_ROOT_PASSWORD=your_mysql_password_here

# ---------- Redis（必须修改）----------
REDIS_PASSWORD=your_redis_password_here

# ---------- Nacos ----------
NACOS_PASSWORD=your_nacos_password_here
NACOS_AUTH_TOKEN=your_nacos_auth_token_at_least_32_chars_long
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=your_identity_value

# ---------- JWT（必须修改）----------
JWT_TOKEN_SECRET=your_jwt_secret_at_least_32_chars_random_string
JUDGE_TOKEN=your_judge_token_random_string

# ---------- 邮箱（可选）----------
EMAIL_SERVER_HOST=smtp.qq.com
EMAIL_SERVER_PORT=465
EMAIL_USERNAME=your_email@qq.com
EMAIL_PASSWORD=your_email_auth_code
